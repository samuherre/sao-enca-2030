# ============================================================================
# .env.production — Frontend SAO ENCA 2030 (build de DEMO para Vercel)
# ----------------------------------------------------------------------------
# Vite carga este archivo automáticamente durante `vite build` (modo
# production). Activa el MODO ESTÁTICO: el frontend lee el snapshot de la API
# congelado en `public/api-snapshot/` en vez de llamar a un backend.
#
# Este archivo NO contiene secretos (es seguro versionarlo). Solo habilita la
# demo de solo lectura para desplegar el frontend sin servidor ni base de datos.
# La aplicación definitiva migrará a ArcGIS.
# ============================================================================

# Activa la lectura desde el snapshot estático (demo sin backend).
VITE_STATIC_MODE=true

# En modo estático no se usa una API remota; se deja vacío a propósito.
VITE_API_URL=
