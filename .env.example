# ============================================================================
# .env.example — SAO ENCA 2030
# ----------------------------------------------------------------------------
# Plantilla de variables de entorno. NO contiene secretos reales.
# Copiar a `.env` localmente y completar con valores reales.
# NUNCA versionar el archivo `.env` (ver .gitignore). (tech.md §19, §20)
#
# Stack definido (tech.md §3–§10, §39; ADR-001):
#   Python 3.12+ / FastAPI / Pydantic / SQLAlchemy / Alembic / PostgreSQL.
# Las variables de abajo se dejan SIN valor (o comentadas) a propósito: son
# placeholders para completar localmente, no credenciales reales.
# Las variables del componente bibliométrico siguen PENDING_VALIDATION.
# ============================================================================

# --- Entorno -----------------------------------------------------------------
# Valores admitidos (ilustrativos): development | test | production
ENVIRONMENT=

# --- Logging -----------------------------------------------------------------
# Valores admitidos (ilustrativos): DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=

# --- CORS (consumo del frontend React en ejecución local) --------------------
# Orígenes del frontend permitidos por el backend para que el navegador pueda
# consumir la API (Req 7.1). Lista separada por comas. NO es un secreto.
# Si se deja vacío, el backend usa por defecto los orígenes locales de Vite:
#   http://localhost:5173, http://127.0.0.1:5173
# Ejemplo (sin considerarse valor por defecto): http://localhost:5173
CORS_ALLOW_ORIGINS=

# --- Base de datos (PostgreSQL + SQLAlchemy) ---------------------------------
# Completar localmente. NO escribir credenciales reales en este archivo de ejemplo.
# Formato de referencia de SQLAlchemy/PostgreSQL (sin valores reales):
#   postgresql+psycopg://<usuario>:<password>@<host>:<puerto>/<base_de_datos>
DATABASE_URL=

# --- Rutas de datos (configurables, NO rutas absolutas en código) ------------
# Rutas relativas al proyecto. Ajustar según el entorno local autorizado.
DATA_RAW_PATH=./data/raw
DATA_INTERIM_PATH=./data/interim
DATA_PROCESSED_PATH=./data/processed
DATA_EXPORTS_PATH=./data/exports

# --- Componente bibliométrico (PENDING_VALIDATION) ---------------------------
# Sin definir hasta recibir el dataset (DATA-012) y la metodología (DATA-013).
# No descomentar hasta que SAO proporcione el dataset y las definiciones.
# BIBLIOMETRIC_DATASET_PATH=
# CLASSIFIER_MODEL=

# --- Conector OpenAlex por API (fuente-openalex-api) -------------------------
# Mailto_Cortesia del "polite pool" de OpenAlex (https://api.openalex.org).
# OPCIONAL y NO es un secreto: OpenAlex recomienda enviar un correo de contacto
# para obtener mejor servicio y límites, pero la API funciona sin él. El
# conector continúa normalmente si la variable no está definida (Req 1.4, 1.5).
# NUNCA versionar un valor real; dejar comentado como placeholder.
# OPENALEX_MAILTO=tu-correo@ejemplo.org

# --- API key de OpenAlex (fuente-openalex-api / estrategia-bibliometrica-api) -
# API key GRATUITA de OpenAlex. Se obtiene sin costo registrándose en
# https://openalex.org (ver la documentación de la fuente). Habilita la
# paginación por cursor más allá de la primera página: sin ella, OpenAlex
# devuelve HTTP 401 al avanzar con `next_cursor` (Req 7.1, 7.5).
# Se trata como SECRETO: se provee únicamente por variable de entorno y NUNCA se
# versiona en código, documentación, frontend ni repositorio (Req 7.3, 7.4).
# Si no está definida, el conector sigue funcionando sin la API key (Req 7.2).
# NUNCA versionar un valor real; dejar comentado como placeholder.
# OPENALEX_API_KEY=
